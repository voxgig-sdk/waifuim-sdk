# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: artist: {
    path: "/artists": {
      op: list: method: *GET
      op: list: transform: res: *("`body.artists`")|top
    }
  }

  entity: image: {
    path: "/images": {
      op: list: method: *GET
      op: list: transform: res: *("`body.images`")|top
    }
  }

}