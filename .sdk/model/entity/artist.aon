# Entity: artist

main: kit: entity: artist: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the artist"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the artist"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the artist's profile or portfolio"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "artist"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 100
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/artists"
          parts: [
            "artists"
          ]
          select: {
            exist: [
              "page"
              "page_size"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.artists`"
          }
        }
      ]
    }
  }



}
