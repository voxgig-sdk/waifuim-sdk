# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "artist"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "category"
      req: false
      short: "Category of the image"
      type: "`$STRING`"
    }
    {
      name: "height"
      req: false
      short: "Image height in pixels"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the image"
      type: "`$STRING`"
    }
    {
      name: "thumbnail"
      req: false
      short: "URL to the thumbnail version of the image"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the image"
      type: "`$STRING`"
    }
    {
      name: "width"
      req: false
      short: "Image width in pixels"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/images"
          parts: [
            "images"
          ]
          select: {
            exist: [
              "category"
              "page"
              "page_size"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.images`"
          }
        }
      ]
    }
  }



}
