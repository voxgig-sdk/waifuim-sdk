{
  "openapi": "3.0.3",
  "info": {
    "title": "Waifu API",
    "description": "The API for your Waifu content. Access thousands of categorized anime illustrations via our robust REST API or browse freely.",
    "version": "1.0.0",
    "contact": {
      "url": "https://github.com/l0v3m0n3y/waifuim"
    }
  },
  "servers": [
    {
      "url": "https://api.waifu.im",
      "description": "Production server"
    }
  ],
  "paths": {
    "/artists": {
      "get": {
        "summary": "Get artists list",
        "description": "Retrieves a list of artists from the Waifu API database",
        "operationId": "getArtistsList",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of artists to return per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of artists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "artists": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique identifier for the artist"
                          },
                          "name": {
                            "type": "string",
                            "description": "Name of the artist"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "URL to the artist's profile or portfolio"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of artists available"
                    },
                    "page": {
                      "type": "integer",
                      "description": "Current page number"
                    },
                    "pageSize": {
                      "type": "integer",
                      "description": "Number of items per page"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Artists"
        ]
      }
    },
    "/images": {
      "get": {
        "summary": "Get images list",
        "description": "Retrieves a list of categorized anime illustrations",
        "operationId": "getImagesList",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of images to return per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter images by category",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique identifier for the image"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "URL to the image"
                          },
                          "thumbnail": {
                            "type": "string",
                            "format": "uri",
                            "description": "URL to the thumbnail version of the image"
                          },
                          "category": {
                            "type": "string",
                            "description": "Category of the image"
                          },
                          "artist": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Artist identifier"
                              },
                              "name": {
                                "type": "string",
                                "description": "Artist name"
                              }
                            }
                          },
                          "width": {
                            "type": "integer",
                            "description": "Image width in pixels"
                          },
                          "height": {
                            "type": "integer",
                            "description": "Image height in pixels"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of images available"
                    },
                    "page": {
                      "type": "integer",
                      "description": "Current page number"
                    },
                    "pageSize": {
                      "type": "integer",
                      "description": "Number of items per page"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Images"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Artists",
      "description": "Operations related to artists"
    },
    {
      "name": "Images",
      "description": "Operations related to anime illustrations"
    }
  ],
  "externalDocs": {
    "description": "GitHub Documentation",
    "url": "https://github.com/l0v3m0n3y/waifuim"
  }
}
